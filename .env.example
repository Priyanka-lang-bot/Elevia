# Copy this file to .env and fill in values. Never commit .env.

# --- AI model (optional) ---
# "mock" = no AI model. Agents use rule-based logic + template wording, clearly labelled in the UI.
# "anthropic" = Anthropic Messages API.  "openai" = any OpenAI-compatible Chat Completions API
# (OpenAI, Groq, OpenRouter, Gemini's OpenAI-compatible endpoint, ...).
LLM_PROVIDER=mock
LLM_API_KEY=
# Leave blank for the provider default (anthropic: claude-haiku-4-5, openai: gpt-4o-mini)
LLM_MODEL=
# Only needed for non-OpenAI providers using the OpenAI format, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

# --- Teacher access ---
# PIN for the teacher dashboard. If blank, the demo PIN 2468 is used and the UI warns about it.
TEACHER_PIN=

# --- Email (accounts, parent consent, invitations, password reset) ---
# outbox = emails are SAVED in the database instead of sent (for development and demos).
# smtp   = really send, via any SMTP service (Gmail app password, Brevo, Resend, ...).
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Links in emails point here (the website's address)
APP_BASE_URL=http://localhost:8000
# Development only: exposes saved emails at /dev/outbox. Never enable on a public server.
ELEVIA_DEV_OUTBOX=0
# DEMO ONLY: show emailed links on screen instead of sending (only works with EMAIL_MODE=outbox).
# Anyone using the site could then approve their own consent, so never use with real students.
ELEVIA_DEMO_EMAIL_LINKS=0

# --- Database on Vercel (Turso). Leave blank to use the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Workflow ---
RETEST_DELAY_HOURS=24
# Shows a clearly labelled "Demo override: start retest now" button. Set false for real use.
ALLOW_EARLY_RETEST=true

# --- Storage / network ---
ELEVIA_DB_PATH=elevia.db
CORS_ORIGINS=http://localhost:8501

# --- Frontend ---
ELEVIA_API_URL=http://localhost:8000
# Set to 1 to run the FastAPI backend inside the Streamlit process (single-service hosting)
ELEVIA_EMBEDDED=0
# Re-create the sample students automatically when the database is empty (useful on free hosting)
ELEVIA_AUTO_SEED=0
