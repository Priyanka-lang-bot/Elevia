 "lessons": {
  "text_vs_numbers": {
   "title": "Text versus numbers",
   "big_idea": "Quotes make a value text (a string). Text that looks like a number still behaves like text: + sticks strings together and * repeats them.",
   "steps": [
    "Check each value: is it in quotes? Then it's text.",
    "text + text joins them end to end.",
    "text * number repeats the text.",
    "Only real numbers (no quotes) add up arithmetically."
   ],
   "sense_check": "A phone number \"98\" + \"76\" makes \"9876\", not 174.",
   "worked_examples": [
    {
     "prompt": "What does this program print?",
     "code": "a = \"3\"\nb = \"4\"\nprint(a + b)",
     "answer": "34",
     "steps": [
      "\"3\" and \"4\" are text.",
      "+ joins them: 34."
     ]
    },
    {
     "prompt": "What does this program print?",
     "code": "x = \"5\"\nprint(x * 2)",
     "answer": "55",
     "steps": [
      "x is text.",
      "* 2 repeats it: 55."
     ]
    }
   ]
  },
  "type_conversion": {
   "title": "Converting between types",
   "big_idea": "int() turns text into a whole number and str() turns a number into text. After converting, the value follows the rules of its new type.",
   "steps": [
    "Find each int(...) or str(...) and work out the converted value first.",
    "Numbers: + and * do arithmetic.",
    "Text: + joins, * repeats."
   ],
   "sense_check": "int(\"6\") * 2 is 12, because the 6 is now a real number.",
   "worked_examples": [
    {
     "prompt": "What does this program print?",
     "code": "a = \"6\"\nb = int(a) * 2\nprint(b)",
     "answer": "12",
     "steps": [
      "int(\"6\") is the number 6.",
      "6 × 2 = 12."
     ]
    },
    {
     "prompt": "What does this program print?",
     "code": "n = 8\nprint(str(n) + \"1\")",
     "answer": "81",
     "steps": [
      "str(8) is the text \"8\".",
      "\"8\" + \"1\" = 81."
     ]
    }
   ]
  }
 }
