 "lessons": {
  "one_step_equations": {
   "title": "Solving one-step equations",
   "big_idea": "An equation is a balance. To get x on its own, undo what was done to it by doing the OPPOSITE operation to both sides.",
   "steps": [
    "Look at what is happening to x: is something added, subtracted or multiplied?",
    "Choose the opposite: + ↔ −, × ↔ ÷.",
    "Do that opposite to BOTH sides so the balance stays level.",
    "Check: put your answer back into the equation."
   ],
   "sense_check": "If x + 5 = 12 and you said x = 17, check it: 17 + 5 = 22, not 12. So x must be smaller than 12.",
   "worked_examples": [
    {
     "prompt": "Solve for x:  x + 5 = 12",
     "answer": "7",
     "steps": [
      "Subtract 5 from both sides.",
      "x = 12 − 5 = 7.",
      "Check: 7 + 5 = 12 ✓"
     ]
    },
    {
     "prompt": "Solve for x:  3x = 12",
     "answer": "4",
     "steps": [
      "3x means 3 × x.",
      "Divide both sides by 3: x = 4.",
      "Check: 3 × 4 = 12 ✓"
     ]
    }
   ]
  },
  "two_step_equations": {
   "title": "Solving two-step equations",
   "big_idea": "In 2x + 3 = 11, x was first multiplied by 2, then 3 was added. Undo them in REVERSE order: subtract 3 first, then divide by 2.",
   "steps": [
    "Undo the adding or subtracting first.",
    "Then undo the multiplying by dividing.",
    "Do each step to both sides.",
    "Check by substituting your answer."
   ],
   "sense_check": "Getting dressed: socks then shoes. Undressing: shoes first, then socks. Undo in reverse order.",
   "worked_examples": [
    {
     "prompt": "Solve for x:  2x + 3 = 11",
     "answer": "4",
     "steps": [
      "Subtract 3: 2x = 8.",
      "Divide by 2: x = 4.",
      "Check: 2 × 4 + 3 = 11 ✓"
     ]
    },
    {
     "prompt": "Solve for x:  4x + 1 = 21",
     "answer": "5",
     "steps": [
      "Subtract 1: 4x = 20.",
      "Divide by 4: x = 5.",
      "Check: 4 × 5 + 1 = 21 ✓"
     ]
    }
   ]
  }
 }
