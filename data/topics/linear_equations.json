  }
 ],
 "misconceptions": {
  "ALG_SAME_OP": {
   "label": "Does the same operation instead of the opposite one",
   "gap_skill": "one_step_equations",
   "explanation": "Solves x + 5 = 12 as x = 17 by adding 5 again instead of subtracting."
  },
  "ALG_COEFF_SUB": {
   "label": "Subtracts the number in front of x instead of dividing",
   "gap_skill": "one_step_equations",
   "explanation": "Solves 3x = 12 as x = 9."
  },
  "ALG_ORDER": {
   "label": "Undoes the steps in the wrong order",
   "gap_skill": "two_step_equations",
   "explanation": "Solves 2x + 3 = 11 by dividing first: 11 ÷ 2 − 3 = 2.5 instead of 4."
  }
 },
