  {
   "id": "brackets_first",
   "name": "Brackets first",
   "grade": 6,
   "prerequisites": [
    "multiply_before_add"
   ],
   "description": "Brackets are worked out before anything else."
  }
 ],
 "misconceptions": {
  "ARITH_LEFT_TO_RIGHT": {
   "label": "Works strictly left to right, ignoring that × and ÷ come first",
   "gap_skill": "multiply_before_add",
   "explanation": "Works out 3 + 4 × 2 as 7 × 2 = 14 instead of 11."
  },
  "ARITH_ADD_FIRST": {
   "label": "Thinks addition must always be done before subtraction",
   "gap_skill": "multiply_before_add",
   "explanation": "Works out 10 − 3 + 2 as 10 − 5 = 5 instead of 9."
  },
  "ARITH_IGNORE_BRACKETS": {
   "label": "Ignores the brackets",
   "gap_skill": "brackets_first",
   "explanation": "Works out 2 × (3 + 4) as 2 × 3 + 4 = 10 instead of 14."
  }
 },
