{
 "skills": [
  {
   "id": "percent_meaning",
   "name": "What a percentage means",
   "grade": 6,
   "prerequisites": [
    "decimal_place_value"
   ],
   "description": "Per cent as 'out of 100'; converting percentages and decimals."
  },
  {
   "id": "percent_of_quantity",
   "name": "Percentage of an amount",
   "grade": 6,
   "prerequisites": [
    "percent_meaning"
   ],
   "description": "Finding p% of a quantity."
  }
 ],
 "misconceptions": {
  "PCT_DECIMAL_SHIFT": {
   "label": "Moves the decimal point only one place when converting percentages",
   "gap_skill": "percent_meaning",
   "explanation": "Writes 7% as 0.7 (or 0.4 as 4%), forgetting that per cent means out of 100."
  },
  "PCT_SUBTRACT": {
   "label": "Subtracts the percentage number from the amount",
   "gap_skill": "percent_of_quantity",
   "explanation": "Works out 20% of 50 as 50 − 20 = 30."
  },
  "PCT_DIVIDE": {
   "label": "Divides the amount by the percentage number",
   "gap_skill": "percent_of_quantity",
   "explanation": "Works out 20% of 50 as 50 ÷ 20 = 2.5."
  }
 },
 "questions": [
  {
   "id": "PCT-DA1",
   "pool": "diagnostic:percentages:A",
   "skill_id": "percent_meaning",
   "type": "numeric",
   "gap_targets": [
    "percent_meaning"
   ],
   "prompt": "Write 7% as a decimal.",
   "answer": "0.07",
   "hints": [
    "Per cent means 'out of 100'.",
    "To turn a percentage into a decimal, divide by 100: move the point two places left."
   ],
   "solution": [
    "7% means 7 out of 100.",
    "7 ÷ 100 = 0.07."
   ],
   "patterns": {
    "0.7": "PCT_DECIMAL_SHIFT"
   }
  },
