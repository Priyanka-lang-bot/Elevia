 "misconceptions": {
  "STAT_TOTAL_ONLY": {
   "label": "Gives the total instead of dividing by how many",
   "gap_skill": "calculating_mean",
   "explanation": "Adds the values but forgets to divide."
  },
  "STAT_MODE_FOR_MEAN": {
   "label": "Gives the most common value when asked for the mean",
   "gap_skill": "calculating_mean",
   "explanation": "Mixes up the mean and the mode."
  },
  "STAT_MEDIAN_UNSORTED": {
   "label": "Takes the middle value without putting the list in order",
   "gap_skill": "finding_median",
   "explanation": "Picks the middle of the list as written."
  },
  "STAT_MEAN_FOR_MEDIAN": {
   "label": "Calculates the mean when asked for the median",
   "gap_skill": "finding_median",
   "explanation": "Mixes up the two kinds of average."
  }
 },
