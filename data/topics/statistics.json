 "lessons": {
  "calculating_mean": {
   "title": "The mean",
   "big_idea": "The mean shares the total out equally. Add all the values, then divide by how many values there are. The total on its own isn't an average, and neither is the most common value (the mode).",
   "steps": [
    "Add all the values to get the total.",
    "Count how many values there are.",
    "Divide the total by the count.",
    "Check: the mean lies between the smallest and largest values."
   ],
   "sense_check": "The mean of 4, 6, 6 and 8 can't be 24: that's bigger than every value.",
   "worked_examples": [
    {
     "prompt": "Mean of 4, 6, 6, 8?",
     "answer": "6",
     "steps": [
      "Total: 24.",
      "4 values: 24 ÷ 4 = 6."
     ]
    },
    {
     "prompt": "Mean of 5, 9, 10?",
     "answer": "8",
     "steps": [
      "Total: 24.",
      "3 values: 24 ÷ 3 = 8."
     ]
    }
   ]
  },
  "finding_median": {
   "title": "The median",
   "big_idea": "The median is the middle value once the list is IN ORDER. The middle of the unsorted list means nothing, because the order the values were written in is just the order they were collected.",
   "steps": [
    "Rewrite the list from smallest to largest.",
    "Cross off one from each end until one value is left.",
    "That middle value is the median."
   ],
   "sense_check": "For 7, 2, 9, 4, 3 the third value written is 9, but sorted (2, 3, 4, 7, 9) the middle is 4.",
   "worked_examples": [
